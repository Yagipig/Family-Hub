# Sao chep thanh .env.local (local) hoac khai bao tren Vercel (production).
# KHONG commit file .env.local. KHONG dua SUPABASE_SERVICE_ROLE_KEY vao ma frontend.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chi dung o phia may chu (route handler / server action), khong co tien to NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=
# Dia chi website, dung de tao lien ket loi moi
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Bi mat cho cac route cron (>= 16 ky tu). Vercel Cron tu gui "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Khoa ma hoa thong tin nhan tien (AES-256-GCM), 32 byte base64: openssl rand -base64 32. SAO LUU RIENG; mat khoa = khong giai ma duoc ho so cu.
PAYOUT_ENC_KEY=
